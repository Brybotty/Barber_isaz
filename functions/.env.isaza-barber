# Interruptores: correos y pago en línea necesitan secretos en Secret Manager (RESEND_API_KEY y
# WOMPI_*). Mientras no existan, quedan en false y solo se despliega la tienda (crearPedido y
# cancelarPedido). Cuando crees los secretos, pon true y despliega con `firebase deploy --only functions`.
ACTIVAR_CORREOS=false
ACTIVAR_PAGOS_EN_LINEA=false

# Configuración de las funciones en el proyecto real (isaza-barber).
# Los secretos NO van aquí: se guardan en Secret Manager (ver README).

# --- Correos de citas (Resend) ---
# Con onboarding@resend.dev Resend SOLO entrega al correo dueño de la cuenta de Resend.
# Cuando verifiques el dominio en Resend, cámbialo por p. ej. "Isaza <citas@tudominio.com>".
CORREO_REMITENTE="Barbería & Tattoo Isaza <onboarding@resend.dev>"
NEGOCIO_NOMBRE="Barbería & Tattoo Isaza"
NEGOCIO_DIRECCION="Barrio Granada, Cali, Valle del Cauca"
NEGOCIO_MAPA_URL="https://www.google.com/maps?cid=7635056463748619824"
NEGOCIO_INSTAGRAM="isazabarber"
# Dirección pública de la página (sin / al final). Vacía mientras no esté publicada.
URL_SITIO=""

# --- Tienda: pagos con Wompi ---
# Llave PÚBLICA de Wompi (Wompi → Desarrolladores → Llaves del API). Mientras no empiece por "pub_",
# el pago en línea responde "aún no está configurado".
WOMPI_PUBLIC_KEY=pendiente-configurar
