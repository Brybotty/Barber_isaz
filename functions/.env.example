# Interruptores: true solo cuando existan los secretos correspondientes (ver abajo).
ACTIVAR_CORREOS=false
ACTIVAR_PAGOS_EN_LINEA=false

# Copia este archivo como .env.<id-del-proyecto> (despliegue) y llena los datos del negocio.

# Correos de citas (Resend). El dominio del remitente debe estar verificado en Resend.
CORREO_REMITENTE="Mi Barbería <citas@midominio.com>"
NEGOCIO_NOMBRE="Mi Barbería"
NEGOCIO_DIRECCION="Calle 1 # 2-3, Cali"
NEGOCIO_MAPA_URL="https://maps.google.com/?q=Mi+Barberia"
NEGOCIO_INSTAGRAM="mibarberia"
URL_SITIO="https://midominio.com"

# Tienda: llave pública de Wompi. Pruebas: pub_test_...   Producción: pub_prod_...
WOMPI_PUBLIC_KEY=pub_test_REEMPLAZAR

# Los secretos NO van aquí. En producción se guardan en Secret Manager:
#   firebase functions:secrets:set RESEND_API_KEY           (Resend → API Keys, permiso de solo envío)
#   firebase functions:secrets:set WOMPI_INTEGRITY_SECRET   (Wompi → Secretos para integración técnica → Integridad)
#   firebase functions:secrets:set WOMPI_EVENTS_SECRET      (Wompi → Secretos para integración técnica → Eventos)
# Para los emuladores, créalos en functions/.secret.local (ignorado por git):
#   RESEND_API_KEY=solo-emulador
#   WOMPI_INTEGRITY_SECRET=test_integrity_...
#   WOMPI_EVENTS_SECRET=test_events_...
