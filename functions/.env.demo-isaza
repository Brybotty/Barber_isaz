# En la demo con emuladores todo está activo (los secretos salen de functions/.secret.local).
ACTIVAR_CORREOS=true
ACTIVAR_PAGOS_EN_LINEA=true

# Solo para la demo con emuladores (proyecto demo-isaza). No afecta al proyecto real.
# Los correos no salen: solo se registran en el log del emulador.
CORREO_REMITENTE="Barbería & Tattoo Isaza <onboarding@resend.dev>"
NEGOCIO_NOMBRE="Barbería & Tattoo Isaza"
NEGOCIO_DIRECCION="Barrio Granada, Cali, Valle del Cauca"
NEGOCIO_MAPA_URL="https://www.google.com/maps?cid=7635056463748619824"
NEGOCIO_INSTAGRAM="isazabarber"
URL_SITIO="http://localhost:4200"

# El pago en línea abre un checkout simulado en la app en lugar del de Wompi.
WOMPI_PUBLIC_KEY=pub_test_simulado
WOMPI_SIMULADO=true
